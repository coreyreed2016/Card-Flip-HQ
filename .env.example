# Copy this file to ".env" and fill in the values. NEVER commit ".env".

# "sandbox" for testing, "production" for real listings.
EBAY_ENV=sandbox

# From developer.ebay.com > Application Keys (use the keyset that matches EBAY_ENV).
EBAY_CLIENT_ID=your-app-id-here
EBAY_CLIENT_SECRET=your-cert-id-here

# The RuName (eBay Redirect URL name) created for your keyset. NOT a URL.
EBAY_RUNAME=your-runame-here

# 64 hex characters. Encrypts eBay tokens on disk. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# Local server. Keep HOST at 127.0.0.1: the server has no login of its own.
PORT=3000
HOST=127.0.0.1

# Optional: override the OAuth scopes (space separated).
# EBAY_SCOPES=
